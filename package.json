{
  "name": "whatsapp-headless",
  "version": "1.0.0",
  "description": "Send WhatsApp messages and files from scripts and AI agents with no browser and no window: linked-device API over Baileys, with CLI, local HTTP API and MCP server.",
  "main": "src/client.js",
  "scripts": {
    "login": "node src/cli.js login",
    "status": "node src/cli.js status",
    "send": "node src/cli.js send",
    "serve": "node src/server.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/install-shortcut.ps1",
    "mcp": "node src/mcp.js"
  },
  "keywords": [
    "whatsapp",
    "headless",
    "baileys",
    "mcp",
    "ai-agent",
    "automation",
    "no-browser"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "mime-types": "^3.0.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "bin": {
    "wa-headless": "src/cli.js"
  },
  "engines": {
    "node": ">=18"
  }
}
